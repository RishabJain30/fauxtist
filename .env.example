# Copy to .env and adjust for local development. None of these are
# required to run `go run ./cmd/fauxtist` — every one has a sensible
# default (see README.md's Environment variables section).

# --- Server ---
PORT=8080

# --- Room lifecycle (internal/hub) ---
# FAUXTIST_EMPTY_ROOM_TTL_MS=900000
# FAUXTIST_ROOM_SWEEP_INTERVAL_MS=60000
# FAUXTIST_MAX_ROOMS=500

# --- Game/round timing (internal/room) ---
# FAUXTIST_REVEAL_MS=6000
# FAUXTIST_RECONNECT_GRACE_MS=60000
# FAUXTIST_DISCONNECTED_TURN_MS=10000
# FAUXTIST_IMPOSTOR_GUESS_MS=30000

# --- Heartbeat (internal/server) ---
# FAUXTIST_HEARTBEAT_INTERVAL_MS=25000
# FAUXTIST_HEARTBEAT_TIMEOUT_MS=10000

# --- WebSocket origin allowlist ---
# Comma-separated bare hosts (no scheme, no path). Required in
# production (FAUXTIST_ENV=production, or automatically on Render via
# RENDER_EXTERNAL_HOSTNAME) — the process refuses to start without one.
# FAUXTIST_ALLOWED_ORIGINS=your-domain.example.com
# FAUXTIST_ENV=production

# --- TURN (see docs/turn.md) ---
# Only STUN is used if these are left unset; voice still works for most
# users, just without a relay for restrictive NATs.
# FAUXTIST_STUN_URLS=stun:stun.l.google.com:19302
# FAUXTIST_TURN_URLS=turn:your-coturn-host.example.com:3478
# FAUXTIST_TURN_SHARED_SECRET=replace-with-your-coturn-static-auth-secret
# FAUXTIST_TURN_CREDENTIAL_TTL_SECONDS=3600
